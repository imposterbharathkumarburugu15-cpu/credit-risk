# CreditRisk-X Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env to Git.

# Gmail SMTP credentials (use a Google App Password, not your main password)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=CreditRisk-X

# Optional: destination inbox for high-risk employee review alerts (defaults to EMAIL_USER)
EMPLOYEE_REVIEW_EMAIL=risk-review@yourcompany.com

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=creditrisk_x

# Auth & Employee API Key
AUTH_SECRET=change-this-to-a-long-random-secret
EMPLOYEE_API_KEY=change-this-to-an-employee-api-key
