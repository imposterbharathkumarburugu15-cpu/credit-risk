# Abhaya / CreditRisk-X Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env to Git.

EMAIL_USER=your-sender-gmail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=Abhaya

# Optional: destination inbox for high-risk employee review alerts (defaults to EMAIL_USER)
EMPLOYEE_REVIEW_EMAIL=risk-review@yourcompany.com

# MySQL (set MYSQL_SSL=true for Cloud MySQL providers like Aiven / TiDB Cloud)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=creditrisk_x
MYSQL_SSL=false

# Auth & Employee API Key
AUTH_SECRET=change-this-to-a-long-random-secret
EMPLOYEE_API_KEY=change-this-to-an-employee-api-key
